# Copy to .env and fill in. Never commit .env.

# anthropic | openai | mock   (mock = offline fake LLM for development and tests only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Coach writes the four feedback messages; personas answer the survey in Study 3.
# Keep them different models so the simulated participants are not the coach grading itself.
COACH_MODEL=claude-opus-5-5
PERSONA_MODEL=claude-sonnet-5-5
# Optional overrides (default to COACH_MODEL)
# SAFETY_MODEL=
# JUDGE_MODEL=
# PROBE_MODEL=

# Sampling temperature. Sent to OpenAI only: current Claude models reject temperature,
# so on Anthropic the value is ignored and messages.temperature_applied is recorded as empty.
COACH_TEMPERATURE=0.7
PERSONA_TEMPERATURE=0.9
# Anthropic only: reasoning effort (low | medium | high)
COACH_EFFORT=medium
PERSONA_EFFORT=low

# Admin page (/admin) password. Admin is disabled if unset.
ADMIN_PASSWORD=change-me

# SQLite by default. On Render/Railway point this at a persistent disk, e.g. sqlite:////data/study.db
DATABASE_URL=sqlite:///data/study.db

# Study 3a embeddings: openai (needs OPENAI_API_KEY) or tfidf (offline)
# EMBEDDING_PROVIDER=tfidf
